{
  "name": "ekscss-repl",
  "version": "0.0.32",
  "description": "REPL web app to live compile XCSS into CSS with ekscss",
  "repository": "github:maxmilton/ekscss-repl",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun build.ts",
    "dev": "NODE_ENV=development bun build.ts",
    "lint": "bun lint:fmt && bun lint:css && bun lint:js && bun lint:ts",
    "lint:css": "stylelint '**/*.{css,xcss}'",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "serve": "wrangler dev --port 3000",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=3",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ekscss/framework": "0.0.61",
    "ekscss": "0.0.24",
    "stage1": "0.12.1"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.22",
    "@maxmilton/stylelint-config": "0.4.4",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.18",
    "@types/bun": "1.4.3",
    "bugbox": "0.0.4",
    "bun-plugin-ekscss": "0.0.4",
    "happy-dom": "21.0.1",
    "lightningcss": "1.33.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "purgecss": "8.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.0"
  }
}
